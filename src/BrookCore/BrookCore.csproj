<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic with no Windows dependency, so the tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BrookClient.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Symbols inside the dll, so a single-file publish has no stray .pdb. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrookCore.Tests" />
  </ItemGroup>

</Project>
