<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs only on Windows (CI: windows-latest). Renders the UI and drives a real brook end to end. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrookClient\BrookClient.csproj" />
  </ItemGroup>

  <!-- The fake corporate proxy (CONNECT + Basic login) shared with the core tests. -->
  <ItemGroup>
    <Compile Include="..\BrookCore.Tests\TestConnectProxy.cs" Link="TestConnectProxy.cs" />
  </ItemGroup>

  <!-- brook.exe is downloaded by scripts/fetch-brook.ps1 (CI does this before testing). -->
  <ItemGroup>
    <None Include="..\..\vendor\brook.exe" Condition="Exists('..\..\vendor\brook.exe')" CopyToOutputDirectory="PreserveNewest" Link="brook.exe" />
  </ItemGroup>

</Project>
